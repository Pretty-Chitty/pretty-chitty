{
  "name": "@pretty-chitty/core",
  "version": "1.2.2",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "A TypeScript framework for building high-quality async or realtime 3D strategy board games",
  "author": "Pretty Chitty, LLC",
  "homepage": "https://pretty-chitty.github.io/pretty-chitty/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pretty-chitty/pretty-chitty.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "game-engine",
    "board-game",
    "3d",
    "threejs",
    "game-development",
    "strategy-game",
    "multiplayer",
    "typescript",
    "react"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ReactCanvas": {
      "import": "./dist/utilities/CanvasStack/ReactCanvas.js",
      "types": "./dist/utilities/CanvasStack/ReactCanvas.d.ts"
    }
  },
  "files": [
    "dist",
    "src/library",
    "README.md",
    "LICENSE.md"
  ],
  "devDependencies": {
    "@fontsource/quicksand": "^5.2.10",
    "@babel/core": "^7.23.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.23.5",
    "@babel/plugin-syntax-decorators": "^7.23.3",
    "@babel/plugin-transform-typescript": "^7.23.6",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@types/base-64": "^1.0.2",
    "@types/color": "^3.0.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.3",
    "@types/wheel": "^0.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.2.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "css-loader": "^6.9.1",
    "depcheck": "^1.4.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react-refresh": "^0.14.0",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-patch": "^3.3.0",
    "typedoc": "^0.28.15",
    "typescript": "5.9",
    "vitest": "^1.2.0",
    "vitest-mock-extended": "^1.3.1",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-node-externals": "^3.0.0"
  },
  "prettier": {
    "printWidth": 120
  },
  "dependencies": {
    "@egjs/hammerjs": "^2.0.17",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@multiavatar/multiavatar": "^1.0.7",
    "@react-hook/debounce": "^4.0.0",
    "@react-hook/hover": "^4.0.0",
    "@react-hook/size": "^2.1.2",
    "@tweenjs/tween.js": "^23.1.1",
    "@types/react": "^18.2.34",
    "@types/react-dom": "^18.2.14",
    "@types/three": "^0.158.0",
    "base-64": "^1.0.0",
    "color": "^4.2.3",
    "extrude-polyline": "^1.0.6",
    "mui-modal-provider": "^2.4.2",
    "quick-lru": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-interval-hook": "^1.1.4",
    "react-markdown": "^9.0.1",
    "react-random-avatars": "^1.3.1",
    "react-window": "^2.2.1",
    "reflect-metadata": "^0.1.14",
    "three": "^0.158.0",
    "three-csg-ts": "^3.1.13",
    "use-local-storage-state": "^19.1.0",
    "use-long-press": "^3.2.0",
    "wheel": "^1.0.0"
  },
  "scripts": {
    "prepare": "ts-patch install -s",
    "dev": "webpack serve",
    "start": "webpack serve",
    "build": "rm -rf dist && yarn tsc --project tsconfig.build.json && yarn pack",
    "build:no-sourcemaps": "rm -rf dist && yarn tsc --project tsconfig.build.json --sourceMap false --declarationMap false && yarn pack",
    "build:demo": "NODE_ENV=production webpack --config webpack.demo.config.js",
    "build:all": "yarn build && yarn build:demo",
    "test": "vitest",
    "compile:check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "coverage": "vitest run --coverage",
    "docs": "typedoc"
  }
}
